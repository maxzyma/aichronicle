{
  "name": "aichronicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --root site --host 127.0.0.1 --ignore-lock",
    "build": "node automation/checks/content.mjs && astro build --root site",
    "build:review": "REVIEW_PREVIEW=1 astro build --root site",
    "preview": "astro preview --root site --host 127.0.0.1 --ignore-lock",
    "check": "python3 tools/check_docs.py && node automation/checks/content.mjs",
    "test": "node --test tests/*.test.mjs",
    "collect": "node automation/collectors/feeds.mjs",
    "review:report": "node automation/pipeline/review-report.mjs",
    "approve": "node automation/pipeline/approve.mjs",
    "candidates:report": "node automation/pipeline/candidate-report.mjs",
    "check:publication": "node automation/checks/publication.mjs"
  },
  "dependencies": {
    "astro": "7.3.3",
    "fast-xml-parser": "5.11.1",
    "gray-matter": "4.0.3",
    "marked": "^15.0.0",
    "yaml": "^2.8.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
