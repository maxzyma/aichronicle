---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import { timelines, inTimeline, href } from '../data.mjs';
const timeline = timelines.find((t) => t.id === 'main');
---
<Layout>
  <section class="hero"><div><p class="eyebrow">AN OPEN CHRONICLE OF ARTIFICIAL INTELLIGENCE</p><h1>AI 的下一步，<br /><em>藏在来路里。</em></h1><p class="hero-intro">沿着时间，回看改变人工智能的研究、产品与实践。</p></div><div class="hero-side"><span class="hero-number">1950 <span>→</span> 2026</span><p>一条精选主线<br />多种理解 AI 的视角</p><a href={href('about/')}>我们如何筛选事件 →</a></div></section>
  <div class="topic-strip"><span class="eyebrow">换一个视角</span><a class="selected" href={href()}>AI 主时间线 <span>01</span></a><a href={href('timelines/agents/')}>Agent 演进 <span>02 ↗</span></a></div>
  <Timeline timeline={timeline} items={inTimeline('main')} />
</Layout>
